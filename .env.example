# Copia este archivo a .env en la raíz del proyecto y completa los valores.
# Las variables se leen vía ${VAR} en application.properties (spring-dotenv o export previo).

# ---- Base de datos (Supabase Transaction Pooler, puerto 6543) ----
DB_PASSWORD=

# ---- JWT ----
JWT_SECRET=

# ---- Cloudflare Workers AI (generador de diseños) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Supabase Storage (subida de imágenes de diseños) ----
SUPABASE_SERVICE_KEY=

# ---- Gemini (chatbot) ----
GEMINI_API_KEY=

# ---- Correo (SMTP Gmail) ----
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ---- Wompi (pasarela de pagos - sandbox) ----
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_KEY=
WOMPI_REDIRECT_URL=http://localhost:5173/checkout/resultado

# ---- Frontend / URLs ----
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api
